#!/data/data/com.termux/files/usr/bin/bash -e
# Kali Nethunter 2025.3 rootfs 安装脚本（Termux 无需 root）
# 支持 full / minimal / nano 手动选择版本
# 处理“文件名与 SHA256SUMS 中文件名不同”的情况
# 作者：黑客驰（hackerchi）

# 颜色
red='\033[1;31m'
yellow='\033[1;33m'
blue='\033[1;34m'
reset='\033[0m'

# 预清理
pre_cleanup() {
	find "$HOME" -name "kali*" -type d -exec rm -rf {} \; 2>/dev/null || :
} 

# 后清理（旧 rootfs 压缩包）
post_cleanup() {
	find "$HOME" -name "kalifs*" -type f -exec rm -rf {} \; 2>/dev/null || :
} 

########################
#   选择 rootfs 版本   #
########################

setvariant() {
	echo
	echo -e "${blue}[*] 请选择要安装的 Kali Nethunter rootfs 版本：${reset}"
	echo "  1) full    （完整体，体积最大，功能最全）"
	echo "  2) minimal （精简版，体积小，建议一般使用）"
	echo "  3) nano    （极简版，体积最小，需要自己安装组件）"
	echo
	read -p "请输入选项 [1-3]（回车默认 1）： " choice

	case "$choice" in
		1|"")
			chroot="full"
			;;
		2)
			chroot="minimal"
			;;
		3)
			chroot="nano"
			;;
		*)
			echo -e "${red}[!] 无效选项，将默认安装 full 版本。${reset}"
			chroot="full"
			;;
	esac

	echo -e "${blue}[*] 已选择版本：${yellow}${chroot}${reset}"
}

unknownarch() {
	printf "$red"
	echo "[*] 检测到未知 CPU 架构，暂不支持。"
	printf "$reset\n"
	exit 1
}

########################
#   检测系统 CPU 架构  #
########################

checksysinfo() {
	printf "$blue[*] 正在检测宿主机 CPU 架构...$reset\n"
	case "$(getprop ro.product.cpu.abi)" in
		arm64-v8a)
			SETARCH=arm64
			;;
		armeabi|armeabi-v7a)
			SETARCH=armhf
			;;
		*)
			unknownarch
			;;
	esac
	printf "$blue[*] 检测到架构：$yellow$SETARCH$reset\n"
}

########################
#   检查并安装依赖包   #
########################

checkdeps() {
	printf "${blue}\n"
	echo " [*] 正在更新 Termux 包索引 (apt update)..."
	apt update -y &> /dev/null
	echo " [*] 正在检查所需工具：proot / tar / axel..."

	for i in proot tar axel; do
		if [ -e "$PREFIX/bin/$i" ]; then
			echo "  • $i 已安装"
		else
			echo "  • 正在安装 $i ..."
			apt install -y "$i" || {
				printf "$red"
				echo " [!] 安装 $i 失败，请检查网络连接或 apt 配置。"
				echo "     安装终止。"
				printf "$reset\n"
				exit 1
			}
		fi
	done
	echo " [*] 正在执行 apt upgrade（可略耗时）..."
	apt upgrade -y
}

########################################
#   设置下载 URL 与 SHA256SUMS 路径    #
########################################
# 真实目录中的 rootfs 文件名：
#   kali-nethunter-rootfs-${chroot}-${SETARCH}.tar.xz
# SHA256SUMS 文件中对应的文件名：
#   kali-nethunter-2025.3-rootfs-${chroot}-${SETARCH}.tar.xz

seturl() {
	BASEURL="https://kali.download/nethunter-images/current/rootfs"
	# 实际下载的文件名（无版本号）
	REAL_TAR_NAME_NO_VER="kali-nethunter-rootfs-${chroot}-${SETARCH}.tar.xz"
	# SHA256SUMS 中的文件名（带 2025.3 版本号）
	REAL_TAR_NAME_VER="kali-nethunter-2025.3-rootfs-${chroot}-${SETARCH}.tar.xz"
	URL="${BASEURL}/${REAL_TAR_NAME_NO_VER}"
	SHA_INDEX="${BASEURL}/SHA256SUMS"
}

########################
#     下载 rootfs      #
########################

gettarfile() {
	printf "$blue[*] 正在下载 Kali Nethunter rootfs...$reset\n\n"
	seturl
	# 注意：统一约定 rootfs 解压目录为 $HOME/kali-${SETARCH}
	DESTINATION="$HOME/kali-${SETARCH}"
	cd "$HOME" || exit 1

	# 本地统一命名
	rootfs="kalifs-${SETARCH}-${chroot}.tar.xz"

	if [ ! -f "$rootfs" ]; then
		echo " [*] 下载地址："
		echo "     $URL"
		axel ${EXTRAARGS} --alternate "$URL" -o "$REAL_TAR_NAME_NO_VER"
		mv "$REAL_TAR_NAME_NO_VER" "$rootfs"
	else
		printf "${red}[!] 检测到本地已存在 rootfs 压缩包：$rootfs\n"
		printf "    将直接使用该文件。\n"
		printf "    若你怀疑该文件不完整或损坏，请手动删除后重新运行脚本。\n${reset}\n\n"
	fi
}

########################
#     获取校验信息      #
########################

getsha() {
	printf "\n${blue}[*] 正在获取 SHA256SUMS 校验信息... $reset\n\n"
	cd "$HOME" || exit 1

	if [ -f "kalifs-${SETARCH}-${chroot}.sha256sum" ]; then
		rm "kalifs-${SETARCH}-${chroot}.sha256sum"
	fi

	seturl
	SUMFILE_ALL="SHA256SUMS"
	echo " [*] 正在下载 SHA256SUMS 文件..."
	axel ${EXTRAARGS} --alternate "$SHA_INDEX" -o "$SUMFILE_ALL"

	dos2unix "$SUMFILE_ALL" 2>/dev/null || :

	echo " [*] SHA256SUMS 文件前几行示例："
	head "$SUMFILE_ALL" | sed 's/^/    /'

	# 使用带 2025.3 的文件名匹配
	if ! grep -E "[0-9a-fA-F]{64}  ${REAL_TAR_NAME_VER}$" "$SUMFILE_ALL" \
		> "kalifs-${SETARCH}-${chroot}.sha256sum"; then
		printf "$red[!] 在 SHA256SUMS 中未找到文件：${REAL_TAR_NAME_VER}\n"
		printf "    请确认远程目录与版本是否匹配。${reset}\n"
		exit 1
	fi
}

########################
#      校验文件完整    #
########################

checkintegrity() {
	printf "\n${blue}[*] 正在校验 rootfs 文件完整性...\n"
	echo " [*] 如果校验失败，脚本会立即退出。"
	printf ' '

	cd "$HOME" || exit 1
	seturl

	if [ ! -f "$rootfs" ]; then
		printf "$red\n[!] 未找到 rootfs 文件：$rootfs\n${reset}"
		exit 1
	fi

	# 复制一份，临时改名成 SHA256SUMS 中使用的文件名
	TEMP_NAME="${REAL_TAR_NAME_VER}"
	cp "$rootfs" "$TEMP_NAME"

	if ! sha256sum -c "kalifs-${SETARCH}-${chroot}.sha256sum"; then
		rm -f "$TEMP_NAME"
		printf "$red\n[!] 很遗憾，rootfs 文件校验失败（可能损坏或未下载完整）。\n"
		printf "    请删除相关压缩文件后，重新运行本脚本下载。\n${reset}"
		exit 1
	fi

	rm -f "$TEMP_NAME"
	printf "${blue}\n[*] rootfs 文件完整性校验通过！${reset}\n"
}

########################
#       解压 rootfs    #
########################

extract() {
	printf "$blue[*] 正在解压 rootfs，这可能会花费一些时间，请耐心等待... $reset\n\n"
	cd "$HOME" || exit 1
	proot --link2symlink tar -xf "$rootfs" -C "$HOME" 2> /dev/null || :

	echo -e "${blue}[*] 解压完成，当前 \$HOME 下的 kali 相关目录：${reset}"
	ls -d "$HOME"/kali* 2>/dev/null || echo "  （未发现以 kali 开头的目录）"
}

####################################
# 自动检测解压后的 Kali 根目录路径 #
####################################

detect_destination() {
	# 现在已知：你的系统实际解压目录为 $HOME/kali-arm64
	# 我们统一约定：DESTINATION = $HOME/kali-${SETARCH}

	local guess="$HOME/kali-${SETARCH}"

	if [ -d "$guess" ] && [ -d "$guess/etc" ]; then
		DESTINATION="$guess"
		echo -e "${blue}[*] 使用 Kali 根目录：${yellow}$DESTINATION${reset}"
		return
	fi

	echo -e "${blue}[*] 未在预期位置找到 Kali 目录，尝试自动搜索（深度 5）...${reset}"

	# 兜底搜索：包含 bin/bash 且上级目录有 etc
	local candidate
	candidate=$(find "$HOME" -maxdepth 5 -type f -name "bash" -path "*/bin/bash" 2>/dev/null | head -n 10)

	if [ -z "$candidate" ]; then
		echo -e "${red}[!] 搜索不到包含 bin/bash 的目录。${reset}"
		echo "    请运行以下命令，并把输出发给我："
		echo "      cd \$HOME"
		echo "      ls"
		echo "      ls -d kali*"
		echo "      find \$HOME -maxdepth 5 -type d -name etc"
		exit 1
	fi

	local first
	first=$(echo "$candidate" | head -n 1)
	DESTINATION="$(dirname "$(dirname "$first")")"

	if [ -d "$DESTINATION/etc" ]; then
		echo -e "${blue}[*] 自动检测到 Kali 根目录：${yellow}$DESTINATION${reset}"
	else
		echo -e "${red}[!] 自动检测到目录：$DESTINATION，但未找到 etc 目录。${reset}"
		exit 1
	fi
}

########################
#   创建启动脚本       #
########################

createloginfile() {
	# 不同版本使用不同启动命令，避免冲突
	bin="${PREFIX}/bin/startkali-${chroot}"
	[ "$chroot" = "full" ] && bin="${PREFIX}/bin/startkali"

	cat > "$bin" <<- 'EOM'
#!/data/data/com.termux/files/usr/bin/bash -e
# Kali Nethunter 启动脚本（Termux）
unset LD_PRELOAD
DESTINATION=DESTINATION_PATH
if [ ! -f $DESTINATION/root/.version ]; then
    touch $DESTINATION/root/.version
fi
user=kali
home="/home/$user"
LOGIN="sudo -u $user /bin/bash"
if [[ ("$#" != "0" && ("$1" == "-r")) ]]; then
    user=root
    home=/$user
    LOGIN="/bin/bash --login"
    shift
fi

cmd="proot \
    --link2symlink \
    -0 \
    -r ${DESTINATION} \
    -b /dev \
    -b /proc \
    -b $DESTINATION$home:/dev/shm \
    -b /sdcard \
    -b $HOME \
    -w $home \
    /usr/bin/env -i \
    HOME=$home TERM=\"$TERM\" \
    LANG=$LANG PATH=/bin:/usr/bin:/sbin:/usr/sbin \
    $LOGIN"

args="$@"
if [ "$#" == 0 ]; then
    exec $cmd
else
    $cmd -c "$args"
fi
EOM

	sed -i "s|DESTINATION_PATH|${DESTINATION}|g" "$bin"
	chmod 700 "$bin"
	echo -e "${blue}[*] 已创建启动脚本：${yellow}$bin${reset}"
}

########################
#   resolv.conf 配置   #
########################

resolvconf() {
	if [ ! -d "${DESTINATION}/etc" ]; then
		echo -e "${red}[!] 未找到 ${DESTINATION}/etc 目录，无法写入 resolv.conf。${reset}"
		return
	fi
	printf "nameserver 8.8.8.8\nnameserver 8.8.4.4\n" > "${DESTINATION}/etc/resolv.conf"
	echo -e "${blue}[*] 已写入 DNS 配置到：${yellow}${DESTINATION}/etc/resolv.conf${reset}"
}

printline() {
	printf "${blue}\n"
	echo " #----------------------------------------------#"
}

################
#    主流程    #
################

clear
EXTRAARGS=""
if [[ -n "$1" ]]; then
    EXTRAARGS="$1"
    if [[ "$EXTRAARGS" != "--insecure" ]]; then
		EXTRAARGS=""
    fi
fi

printf "\n${yellow} 你正在使用 Termux 无需 root 安装 Kali Nethunter。\n"
printf " 本脚本作者：黑客驰（hackerchi）\n\n${reset}"

pre_cleanup
checksysinfo
checkdeps
setvariant
gettarfile
getsha
checkintegrity
extract
detect_destination
createloginfile
post_cleanup

printf "$blue[*] 正在为你配置 Kali 网络与环境...$reset\n"

resolvconf

################
# finaltouchup #
################

finalwork() {
	DESTINATION="$DESTINATION" SETARCH="$SETARCH" \
		bash "$HOME/Nethunter-In-Termux/finaltouchup.sh"
} 
finalwork

printline
printf "\n${yellow} 现在你已经可以在 Termux 中愉快地使用 Kali Nethunter 了！:)\n"
printf " 提示：\n"
printf "   • 若安装 full 版本：使用命令 ${blue}startkali${yellow} 启动\n"
printf "   • 若安装 minimal 版本：使用命令 ${blue}startkali-minimal${yellow} 启动\n"
printf "   • 若安装 nano 版本：使用命令 ${blue}startkali-nano${yellow} 启动\n"
printline
printline
printf "\n${blue}[*] 作者邮箱：${yellow}hackerchi99@gmail.com\n"
printf "${blue}[*] 作者博客：${yellow}hackerchi.top\n"
printline
printf "$reset\n"